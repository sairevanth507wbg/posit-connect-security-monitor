# Posit Connect Security Monitoring System - Phase 1 (Inventory Discovery)
# Copy this file to .env and fill in real values. Never commit .env.

# ============================================================
# Posit Connect  (required)
# ============================================================
# Base URL only - do not include /__api__
CONNECT_SERVER_URL=https://connect.example.com
# Generate under: Connect UI > your user menu > API Keys
# An ADMINISTRATOR key is strongly recommended; a publisher key only sees
# content it owns, which produces a silently incomplete inventory.
CONNECT_API_KEY=replace-with-your-posit-connect-api-key

# ============================================================
# PostgreSQL  (required)
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=connect_inventory
POSTGRES_USER=connect_inventory
POSTGRES_PASSWORD=replace-with-your-database-password

# ============================================================
# Wiz  (optional - vulnerability scanning)
# ============================================================
# Leave blank until OIS issues credentials. The inventory scan runs
# without them; only the vulnerability step is skipped.
# Confirm the two URLs with OIS - the API host varies by tenant.
# WIZ_API_URL=https://api.<region>.app.wiz.io/graphql
# WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
# WIZ_AUDIENCE=wiz-api
# WIZ_CLIENT_ID=your-service-account-client-id
# WIZ_CLIENT_SECRET=your-service-account-secret

# ============================================================
# Optional - connection pool
# ============================================================
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_ECHO=false
# Fail fast when the database host is unreachable.
# DB_CONNECT_TIMEOUT=10

# ============================================================
# Optional - HTTP behaviour and retry
# ============================================================
# REQUEST_TIMEOUT=30
# MAX_RETRIES=3
# RETRY_INITIAL_WAIT=0.5
# RETRY_MAX_WAIT=10
# PAGE_SIZE=500
# VERIFY_SSL=true

# ============================================================
# Optional - throughput (matters on a large estate)
# ============================================================
# One packages request per application, fetched concurrently.
# MAX_WORKERS=8
# BATCH_SIZE=50

# ============================================================
# Optional - logging
# ============================================================
# LOG_LEVEL=INFO
# LOG_JSON=true
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
# Set true if your console cannot render Unicode check marks.
# ASCII_OUTPUT=false
